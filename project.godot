config_version=5

[application]

config/name="FaculProjetoCodex"
run/main_scene="res://world/cenario.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
InventoryManager="*uid://bu7e22o5ebv6k"
GameUI="*res://ui/hud/game_ui.tscn"
AudioManager="*uid://bsoylpfnj4i7t"

[display]

window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="FaculProjetoCodex"

[editor_plugins]

enabled=PackedStringArray("res://addons/2d_controls_toolkit/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

